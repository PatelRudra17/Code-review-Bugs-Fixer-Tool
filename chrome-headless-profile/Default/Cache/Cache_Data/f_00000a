      severity: "critical",
      category: "Security",
      line: getLineNumber(content, /eval\s*\(/),
      title: "Avoid eval in production code",
      description: "Dynamic code execution makes the file vulnerable to injection and is hard to reason about safely.",
      fix: "Replace eval with explicit parsing or a constrained lookup table.",
      explanation: "Removing eval closes off an entire class of code-injection bugs.",
    });
  }

  if (/dangerouslySetInnerHTML|innerHTML\s*=/.test(content)) {
    addIssue(issues, {
      severity: "high",
      category: "Security",
      line: getLineNumber(content, /dangerouslySetInnerHTML|innerHTML\s*=/),
      title: "Unsanitized HTML rendering risk",
      description: "Rendering raw HTML can expose the UI to XSS if any untrusted value reaches this path.",
      fix: "Sanitize the HTML or render structured data through normal templates/components instead.",
      explanation: "Even trusted inputs can become unsafe over time when data sources change.",
    });
  }

