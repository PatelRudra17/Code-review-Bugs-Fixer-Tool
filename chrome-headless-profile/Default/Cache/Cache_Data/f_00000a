const JS_LIKE_LANGUAGES = new Set([
  "javascript",
  "typescript",
  "jsx",
  "tsx",
  "json",
]);

const ISSUE_PENALTIES = {
  critical: 25,
  high: 15,
  medium: 8,
  low: 3,
  info: 1,
